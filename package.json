{
  "name": "agent-debugger",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "agent": "tsx --conditions=react-server src/agent/cli.ts",
    "runs": "tsx src/recorder/runs-cli.ts",
    "show": "tsx src/recorder/show-cli.ts",
    "test": "vitest run",
    "test:sample": "vitest run --root sample-project"
  },
  "dependencies": {
    "groq-sdk": "^1.6.0",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
