# Copy this file to .env.local and fill it in. Never commit .env.local.
# None of these may start with NEXT_PUBLIC_: that would send them to the browser.

# Groq key from https://console.groq.com
GROQ_API_KEY=

# Neon Postgres: the pooled URL for the app, the direct URL for migrations
DATABASE_URL=
DIRECT_URL=

# Password the CLI sends with each run, so only you can save runs.
# At least 16 characters. To make one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RECORDER_TOKEN=

# Where the CLI sends runs (optional, this is the default)
# RECORDER_URL=http://localhost:3000

# Set to 1 on the public demo site only. The header then says "demo" and the
# hints about running the agent yourself are hidden. Not a secret.
# The demo site needs just DATABASE_URL, RECORDER_TOKEN and this. Never give
# it GROQ_API_KEY or DIRECT_URL.
# DEMO_MODE=1
